# AWS Settings
AWS_REGION=us-east-1
AWS_PROFILE=default

# S3 Buckets (from terraform output)
DVC_BUCKET=mlops-pipeline-dvc-ACCOUNT_ID
MLFLOW_BUCKET=mlops-pipeline-mlflow-ACCOUNT_ID
EVIDENTLY_BUCKET=mlops-pipeline-evidently-ACCOUNT_ID

# MLflow Settings
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fraud-detection
MLFLOW_MODEL_NAME=fraud-detection-xgboost
MLFLOW_DB_SECRET_NAME=mlops-pipeline/mlflow/db-credentials

# Serving Settings
MODEL_STAGE=Production
SERVING_HOST=0.0.0.0
SERVING_PORT=8000

# Monitoring
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:mlops-pipeline-drift-alerts

# Training
DATA_DIR=data
